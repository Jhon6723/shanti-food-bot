{
  "name": "shanti-food",
  "version": "1.0.0",
  "description": "Bot de WhatsApp para arrocería - Spec Driven Development",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "validate-specs": "swagger-cli validate specs/openapi.yaml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.12.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-cli": "^4.0.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^4.1.9",
    "supertest": "^7.2.2",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "food",
    "delivery"
  ],
  "author": "",
  "license": "MIT"
}
