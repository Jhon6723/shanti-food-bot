# Shanti Food - Environment Variables

# PostgreSQL Database
POSTGRES_USER=user123
POSTGRES_PASSWORD=database123
POSTGRES_DB=database1
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Server Configuration
PORT=3000
NODE_ENV=development

# WhatsApp Provider Adapter — see specs/whatsapp-adapter.md
# Active provider: meta | openwa
WHATSAPP_PROVIDER=meta

# --- Provider: Meta (WhatsApp Business Cloud API) ---
# Get these from developers.facebook.com
WHATSAPP_API_VERSION=v18.0
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_BUSINESS_ACCOUNT_ID
WHATSAPP_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
WHATSAPP_VERIFY_TOKEN=YOUR_WEBHOOK_VERIFY_TOKEN
WHATSAPP_APP_SECRET=YOUR_APP_SECRET_FROM_META

# --- Provider: OpenWA (open source) — github.com/rmyndharis/OpenWA ---
WHATSAPP_PROVIDER_URL=http://localhost:2785
WHATSAPP_PROVIDER_API_KEY=YOUR_OPENWA_API_KEY
WHATSAPP_OPENWA_SESSION=shanti-bot
WHATSAPP_PROVIDER_WEBHOOK_SECRET=YOUR_OPENWA_WEBHOOK_SECRET
# IMPORTANT: Set RESOLVE_LID_TO_PHONE=true in OpenWA's .env so webhooks include
# the real sender phone number instead of only the @lid privacy id.

# Auth / Admin Dashboard
JWT_SECRET=generate-with-node-crypto-randomBytes-32-hex
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-before-deploying

# Business Settings
BUSINESS_NAME=Arrocería Shanti
BUSINESS_PHONE=+573123456789
BUSINESS_ADDRESS=Calle Principal #10-20, Barrio Shanti
DELIVERY_FEE=3000
NEQUI_PHONE=312XXXXXXX
